{
  "name": "dsh-webdav-sync",
  "version": "0.1.0",
  "description": "WebDAV sync for DeepSeek Harness - sync settings, sessions, attachments to any WebDAV server (飞牛NAS, Nextcloud, etc.)",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "webdav",
    "sync",
    "nas",
    "飞牛"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/host/index.js",
  "exports": {
    ".": {
      "default": "./lib/host/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "webdav": "^5.10.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-settings": "^0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node -e \"console.log('OK')\"",
    "test": "vitest run",
    "build": "tsc --project tsconfig.lib.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^4.1.0"
  },
  "devDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
